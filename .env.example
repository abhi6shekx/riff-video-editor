# ==============================================================================
# RIFF Platform — Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT:
# - NEVER place real secrets or production credentials in this file or Git.
# - In production (e.g. Vercel), set these in the platform environment dashboard.
# - Variables prefixed with VITE_ are PUBLIC and bundled into client browser code.
# - All other variables are SERVER_ONLY and strictly isolated to server runtimes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT [SERVER_ONLY]
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Canonical production base URL (must use HTTPS in production, e.g. https://riff.app)
APP_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [SERVER_ONLY / SECRET]
# ------------------------------------------------------------------------------
# Neon PostgreSQL pooled connection string
# Local development and sandbox preview use embedded PGLite automatically when unset.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY [SERVER_ONLY / SECRET]
# ------------------------------------------------------------------------------
# Secret for session signing and encryption (minimum 32 random characters in production)
BETTER_AUTH_SECRET=your-32-char-random-auth-secret-here
# Public flag controlling whether Better Auth UI is enabled (true/false)
VITE_AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# 4. SUPABASE / OBJECT STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
# Public client connection endpoints (Safe for browser bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only elevated service role key (NEVER expose to client) [SECRET]
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key-here

# ------------------------------------------------------------------------------
# 5. AI ENGINE & EXTERNAL SERVICES (OPTIONAL) [SERVER_ONLY / SECRET]
# ------------------------------------------------------------------------------
# Server-side xAI key for enhanced AI Studio generation
XAI_API_KEY=your-xai-api-key-here

# ------------------------------------------------------------------------------
# 6. PAYMENT & PAYOUT WEBHOOKS (OPTIONAL) [SERVER_ONLY / SECRET]
# ------------------------------------------------------------------------------
# Webhook signature verification secrets
WEBHOOK_SECRET=your-webhook-signing-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
